# ─── PLUTO: секреты серверной части ──────────────────────────────────────────
# Скопируйте в .env рядом с docker-compose.yml и заполните:
#   cp .env.example .env && nano .env
# Надёжные значения можно сгенерировать:  openssl rand -hex 32

# Пароль пользователя pluto в PostgreSQL (внутренняя БД)
DB_PASS=change_me_db_password

# Пароль администратора веб-консоли (логин: admin). Смените после первого входа.
ADMIN_PASSWORD=pluto

# Секрет подписи JWT-сессий (случайная строка от 64 символов)
JWT_SECRET=change_me_random_string_at_least_64_chars_long_xxxxxxxxxxxxxxxx
