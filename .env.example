# .env — создайте рядом с docker-compose.yml (cp .env.example .env)
# Файл необязателен: без него действуют значения по умолчанию.

# Пароль администратора (логин: admin). Смените после первого входа.
ADMIN_PASSWORD=pluto

# Порт консоли на хосте. Если 8080 занят (Zabbix и т.п.) — раскомментируйте:
# PLUTO_HTTP_PORT=8090

# Порт публичной витрины на хосте:
# PLUTO_SHOWCASE_PORT=8081

# Часовой пояс сервера:
# TZ=Europe/Moscow
