# .env — НЕОБЯЗАТЕЛЬНО. Создайте рядом с docker-compose.yml только если хотите
# переопределить значения по умолчанию (cp .env.example .env).
# Без этого файла PLUTO запустится с паролем admin=pluto и портами 8080/8443.

# Пароль администратора по умолчанию (логин: admin).
# Смените после первого входа: Настройки -> Пользователи -> admin.
ADMIN_PASSWORD=pluto

# Порты на хосте. Если 8080 занят другим сервисом (например, zabbix-web),
# задайте свободные — консоль откроется на новом порту.
# PLUTO_HTTP_PORT=8090
# PLUTO_AGENT_PORT=8443
