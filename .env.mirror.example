# .env для ЗЕРКАЛА-РЕТРАНСЛЯТОРА (машина с публичным IP)
# Скопируйте в .env рядом с docker-compose-mirror.yml

# ОБЩИЙ СЕКРЕТ — должен точно совпадать со значением во вкладке
# «Настройки -> Зеркало -> Секрет» на ОСНОВНОМ сервере. Минимум 32 символа.
# Сгенерировать: openssl rand -hex 32
MIRROR_SECRET=

# Пароль администратора консоли зеркала (логин: admin)
ADMIN_PASSWORD=pluto

# Порт консоли на хосте (за ним обычно стоит Caddy с HTTPS)
# PLUTO_HTTP_PORT=8080
